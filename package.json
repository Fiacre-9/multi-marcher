{
  "name": "boutiquepro",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "prestart": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});for(const f of ['app.js','index.html','style.css'])if(fs.existsSync(f))fs.copyFileSync(f,'public/'+f)\"",
    "start": "node server.js",
    "build": "node --check server.js"
  },
  "engines": { "node": ">=18" },
  "private": true,
  "dependencies": { "express": "^4.21.2" }
}
